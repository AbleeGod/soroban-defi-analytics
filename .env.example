# ─────────────────────────────────────────────────────────────
#  .env.example  –  Copy to .env.local and fill in values.
#  Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Set to "true" to use mock data instead of live API calls.
# Keep true for local dev and CI until live adapters are ready.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Soroswap DEX API base URL (used by the live adapter in Issue #3)
NEXT_PUBLIC_SOROSWAP_API_URL=https://api.soroswap.finance

# Optional: Stellar Horizon RPC endpoint
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Optional: Mercury Indexer API key for historical data
MERCURY_API_KEY=

# Optional: Lighthouse CI token (used in CI workflow)
LHCI_GITHUB_APP_TOKEN=
